// nf-core/sarek's own `-profile test` caps per-process memory at 15 GB
// (see conf/test.config in the pipeline repo), which is more than this
// machine's WSL2 instance actually has (~7.7 GB). This file lowers that
// cap to fit, passed on the command line with `-c laptop.config` alongside
// `-profile test,docker`. Nextflow's `resourceLimits` clamps any process
// that asks for more than these numbers down to these numbers, rather than
// failing the run.
process {
    resourceLimits = [
        cpus: 4,
        memory: '6.GB',
        time: '4.h'
    ]
}
