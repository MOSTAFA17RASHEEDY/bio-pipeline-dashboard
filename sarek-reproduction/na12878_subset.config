// Phase 2 (real NA12878 subset): tell sarek we are NOT using an iGenomes
// reference bundle. These two are set here rather than on the command line
// because nf-core's schema validation needs `igenomes_ignore` to be a real
// boolean, and a bare `--igenomes_ignore` flag arrived as the string "true"
// under Nextflow 26.x. The actual reference/known-sites paths are passed on
// the command line in scripts/run_na12878_subset.sh so they stay visible.
params {
    genome          = null
    igenomes_ignore = true
}
