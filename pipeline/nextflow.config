// Run every process inside Docker (as opposed to Nextflow's default of
// executing scripts directly on the host).
docker.enabled = true

// Nextflow normally symlinks input files into each task's work directory.
// That fails with "Operation not permitted" when the project lives on a
// Windows drive mounted into WSL2 (/mnt/e/...), since DrvFs doesn't support
// symlinks by default. Copying instead is slightly less efficient but works
// everywhere -- fine at this project's toy data sizes.
process.stageInMode = 'copy'

// Default input/output locations. Override on the command line with
// `--reads path/to/other.fastq` etc. if you ever want to point the
// pipeline at different data without editing this file.
params {
    reads     = "${projectDir}/data/sample_reads.fastq"
    reference = "${projectDir}/data/reference.fasta"
    outdir    = "${projectDir}/results"
}

// Which Docker image each process runs in. Built locally via the
// Dockerfiles in docker/{qc,align,variant_call}/ -- see README.md.
process {
    withName: QUALITY_CHECK {
        container = 'bio-pipeline/qc:latest'
    }
    withName: ALIGNMENT {
        container = 'bio-pipeline/align:latest'
    }
    withName: VARIANT_CALLING {
        container = 'bio-pipeline/variant-call:latest'
    }
}
